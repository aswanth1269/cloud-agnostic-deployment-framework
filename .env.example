# Copy to .env and adjust. Every value is optional - sensible defaults apply.

# Port the API + dashboard listens on
PORT=3000

# If set, POST /deploy requires the "x-api-key" header with this value.
# Leave unset for local development only. ALWAYS set in production.
API_KEY=

# Allowed CORS origin for cross-origin API access (default: same-origin only)
CORS_ORIGIN=

# Default deploy mode. "true" = simulate (log every command, execute nothing).
# The dashboard can override this per request.
DEPLOY_DRY_RUN=false

# Container registry to push images to, e.g. ghcr.io/aswanth1269
# When unset, images are built locally and loaded into Minikube.
IMAGE_REGISTRY=
IMAGE_TAG=latest

# kubectl contexts for REAL multi-cloud targeting. When a context is set for
# the selected cloud, the framework deploys to that cluster via
# `kubectl --context <ctx> apply -k k8s/overlays/<cloud>` instead of the
# local Minikube namespace simulation.
KUBE_CONTEXT_AWS=
KUBE_CONTEXT_AZURE=
KUBE_CONTEXT_GCP=

# Where deployment history is persisted (JSON file)
HISTORY_FILE=data/deployments.json

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
