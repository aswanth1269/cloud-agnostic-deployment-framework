{
  "name": "cloud-agnostic-deployment-framework",
  "version": "2.0.0",
  "private": true,
  "description": "Policy-driven, cloud-agnostic deployment framework with a web dashboard, async deploy jobs, and GitOps-ready manifests",
  "main": "app/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app/server.js",
    "dev": "node --watch app/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "deploy:k8s": "node deployment/deploy.js",
    "deploy:dry-run": "node deployment/deploy.js --dry-run",
    "sync:argocd": "node deployment/syncArgoFromPolicy.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web install"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0"
  }
}